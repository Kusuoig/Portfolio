---
<section id="hero" class="max-h-screen flex flex-col justify-center items-center text-center py-20 relative px-4">
  <div class="max-w-6xl mx-auto w-full flex flex-col items-center">
    
    <h1 class="font-display font-extrabold text-text-main leading-[1.1] tracking-tight mb-4 flex flex-wrap justify-center gap-x-4 gap-y-2" aria-label="Diego Villalobos Pascacio">
      <!-- Elementos estructurados para el efecto Text Reveal -->
      <span class="overflow-hidden inline-block py-1"><span class="name-word inline-block text-[clamp(3.5rem,8vw,8rem)]">Diego</span></span>
      <span class="overflow-hidden inline-block py-1"><span class="name-word inline-block text-[clamp(3.5rem,8vw,8rem)] text-primary italic">Villalobos</span></span>
      <span class="overflow-hidden inline-block py-1"><span class="name-word inline-block text-[clamp(3.5rem,8vw,8rem)]">Pascacio</span></span>
    </h1>
    
    <div class="overflow-hidden mt-2">
      <p class="hero-subtitle text-[clamp(1.1rem,2vw,1.5rem)] text-text-main/70 font-body tracking-wider opacity-0 translate-y-full" data-i18n="hero.role">
        Full Stack Developer <span class="text-secondary mx-3">|</span> UI/UX Specialist
      </p>
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);
  
  document.addEventListener('DOMContentLoaded', () => {
    const words = document.querySelectorAll(".name-word");
    const duration = 1 + words.length * 0.05;
    
    // Al usar scrollTrigger vinculamos la animación a la visibilidad de la sección
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "#hero",
        start: "top bottom",
        end: "bottom top",
        toggleActions: "play reverse play reverse"
      }
    });

    // Efecto Text Reveal
    tl.fromTo(
      words,
      { y: "110%" },
      {
        y: "0%",
        duration: duration,
        stagger: {
          amount: 0.6,
        },
        ease: "expo.out",
      }
    )
    // Animación de aparición para el subtítulo, traslapado ligeramente con el reveal
    .to(".hero-subtitle", {
      y: 0,
      opacity: 1,
      duration: 1,
      ease: "power4.out"
    }, "-=0.8");
  });
</script>